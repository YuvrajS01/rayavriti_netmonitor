# ─── Server ───────────────────────────────────────────────────
APP_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Security ─────────────────────────────────────────────────
# REQUIRED — use: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32
ADMIN_USERNAME=admin
# REQUIRED — hashed on first boot
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─── API Keys ─────────────────────────────────────────────────
# Optional — pre-seed an API key
DEFAULT_API_KEY=

# ─── Database (PostgreSQL + TimescaleDB) ──────────────────────
# Use: postgres://user:pass@host:5432/dbname?sslmode=disable
DATABASE_URL=postgres://CHANGEME_USER:CHANGEME_PASSWORD@localhost:5433/netmonitor?sslmode=disable
POSTGRES_DB=netmonitor
POSTGRES_USER=CHANGEME_USER
POSTGRES_PASSWORD=CHANGEME_STRONG_PASSWORD_HERE
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_HEALTH_CHECK_PERIOD=30s

# ─── Redis (Optional Cache Layer) ────────────────────────────
REDIS_ENABLED=true
REDIS_PASSWORD=CHANGEME_STRONG_REDIS_PASSWORD
REDIS_URL=redis://:CHANGEME_STRONG_REDIS_PASSWORD@localhost:6379/0
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=5

# ─── Data Retention ───────────────────────────────────────────
METRICS_RETENTION_DAYS=7
FLOWS_RETENTION_DAYS=2
ALERTS_RETENTION_DAYS=14

# ─── Monitoring Tables Retention ──────────────────────────────
MON_HTTP_RETENTION_DAYS=7
MON_DB_RETENTION_DAYS=3
MON_COLLECTOR_RETENTION_DAYS=14
MON_AUDIT_RETENTION_DAYS=365
MON_HEALTH_RETENTION_DAYS=30
MON_ALERT_RETENTION_DAYS=30

# ─── Network Collectors ──────────────────────────────────────
NETFLOW_PORT=2055
PORT_DISCOVERY_ENABLED=true
PORT_DISCOVERY_INTERVAL_MINUTES=60
PORT_SCAN_TIMEOUT_MS=900
PORT_SCAN_CONCURRENCY=16
CAPTURE_ENABLED=false
CAPTURE_PAYLOAD_ENABLED=false
CAPTURE_MAX_DURATION_SEC=300
CAPTURE_MAX_PACKETS=10000
CAPTURE_MAX_BYTES=10485760

# ─── Logging ──────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=pretty
LOG_FILE_ENABLED=false
LOG_FILE_PATH=./data/logs/netmonitor.log
LOG_FILE_MAX_SIZE_MB=100
LOG_FILE_MAX_BACKUPS=10
LOG_FILE_MAX_AGE_DAYS=30
LOG_FILE_COMPRESS=true
LOG_DB_ENABLED=true
LOG_DB_SAMPLE_RATE=1.0
LOG_DB_QUEUE_SIZE=10000
LOG_DB_DROP_POLICY=drop_debug
LOG_MODULE_LEVELS=
LOG_SLOW_QUERY_MS=100
LOG_SLOW_REQUEST_MS=1000

# ─── Phase 2: Campus Features ─────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
TELEGRAM_MODE=polling
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_SENDER_NUMBER=
SMS_GATEWAY_URL=
SMS_API_KEY=
SMS_SENDER_ID=
REPORT_OUTPUT_DIR=./data/reports
REPORT_SMTP_HOST=
REPORT_SMTP_PORT=587
REPORT_SMTP_USER=
REPORT_SMTP_PASS=
REPORT_FROM_EMAIL=netmonitor@college.edu
ISP_MONITOR_INTERVAL=10
ISP_EXTERNAL_TARGETS=8.8.8.8,1.1.1.1
STATUS_PAGE_TITLE=Campus Network Status
STATUS_PAGE_LOGO_URL=
DISCOVERY_MAX_CONCURRENT=64
DISCOVERY_TIMEOUT_MS=2000
DEFAULT_TIMEZONE=Asia/Kolkata

# ─── Remote Monitoring ────────────────────────────────────────
REMOTE_ENABLED=false
REMOTE_POLL_INTERVAL=60
REMOTE_HEALTH_INTERVAL=30
REMOTE_SNAPSHOT_RETENTION_DAYS=30
REMOTE_HTTP_TIMEOUT=10

# ─── Configuration Sync ───────────────────────────────────────
TELEMETRY_ENDPOINT=
TELEMETRY_SYNC_INTERVAL=21600
TELEMETRY_GRACE_DAYS=7
